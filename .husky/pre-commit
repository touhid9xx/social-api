#!/usr/bin/env sh
# Staged-file gate for the frontend package.
#
# This hook lives at the repository root because the git toplevel is the Python
# project (`social-api`), not `frontend/`. A `.husky/` inside `frontend/` is
# never consulted: husky writes `core.hooksPath` relative to the toplevel and
# git only looks there.
#
# lint-staged has to run from the same toplevel. It resolves each staged path as
# `path.resolve(cwd, filename)`, while git reports filenames relative to the
# repository root — so from `frontend/` a staged `frontend/src/x.ts` would be
# read as `frontend/frontend/src/x.ts`. See lint-staged.config.mjs.
set -e

cd "$(git rev-parse --show-toplevel)"

# Skip the gate entirely unless this commit actually touches `frontend/`.
#
# Without this, a missing or half-installed `frontend/node_modules` makes *every*
# commit in the repository fail — including commits that only touch Python — and
# the error names the frontend rather than the change being committed. The
# backend half of this repo is independently committable, so a broken JS install
# must not be able to wedge it.
#
# `--diff-filter=ACMR` covers added/copied/modified/renamed: a commit that only
# deletes files has nothing left to lint or format.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -q '^frontend/'; then
  exit 0
fi

if [ ! -f frontend/node_modules/lint-staged/bin/lint-staged.js ]; then
  cat >&2 <<'EOF'
husky: frontend dependencies are not installed, so the staged frontend files
cannot be checked. Run:

    cd frontend && pnpm install

Note: lint-staged 17 requires Node >= 22.22.1 (it dropped Node 20 upstream).
If `pnpm install` warns with EBADENGINE, check `node -v` and upgrade — the
engines field in frontend/package.json declares the same floor.
EOF
  exit 1
fi

exec node frontend/node_modules/lint-staged/bin/lint-staged.js --config lint-staged.config.mjs
