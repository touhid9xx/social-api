# Base HTTP origin of the social-api backend. This is the deployed shape: nginx
# on :80 proxying /api/v1/*. Running against `uvicorn` locally there is no nginx,
# so .env.local needs `http://localhost:8000` instead — see README "Environment".
NEXT_PUBLIC_API_URL=http://localhost
# Base WebSocket origin (same host, nginx upgrades /ws/*).
NEXT_PUBLIC_WS_URL=ws://localhost
NEXT_PUBLIC_APP_NAME=Social
