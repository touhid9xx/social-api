# ──────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# ──────────────────────────────────────────────────────────────
# Node / npm
# ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
package-lock.json.bak

# ──────────────────────────────────────────────────────────────
# Testing / Linting caches
# ──────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ──────────────────────────────────────────────────────────────
# Environment & secrets (NEVER commit these)
# ──────────────────────────────────────────────────────────────
.env
.env.prod
.env.local
.env.*.local
secrets/

# ──────────────────────────────────────────────────────────────
# Runtime data (uploads, media, etc.)
# NOTE: the directory itself must NOT be excluded outright - git can
# never re-include a file whose parent directory is excluded, so
# `data/` + `!data/.gitkeep` silently kept .gitkeep out. Exclude the
# *contents* (`data/*`) and negate the paths that must survive.
# ──────────────────────────────────────────────────────────────
data/*
!data/.gitkeep
!data/media/
data/media/*
!data/media/.gitkeep

# ──────────────────────────────────────────────────────────────
# IDE / Editor
# ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ──────────────────────────────────────────────────────────────
# OS
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
*.log
logs/

# ──────────────────────────────────────────────────────────────
# Runtime / generated artifacts (never commit)
# ──────────────────────────────────────────────────────────────
celerybeat-schedule*
gdpr-export*.json
er.name
# PIDs of the dev servers started by scripts/dev-up.ps1 (machine-specific)
.dev-servers.json

# ──────────────────────────────────────────────────────────────
# Keys / certificates
# ──────────────────────────────────────────────────────────────
*.pem
*.key

# ──────────────────────────────────────────────────────────────
# Editor / agent scratch files
# ──────────────────────────────────────────────────────────────
bitnitenPmd

# Throwaway diagnostics / codegen helpers dropped at the repo root
# (`_db_state.py`, `_login.json`, `_f2_*.ps1`, `_f1stage/`, ...).
# NOTE: anchored with a leading `/` so these can only ever match at the
# root - a bare `_*` would also swallow nested `__init__.py`. Listed by
# extension rather than a blanket `/_*` so a genuine root-level file such
# as `_redirects` is not silently ignored.
/_*.ps1
/_*.py
/_*.json
/_*.txt
/_*.log
/_f1stage/
/_f2/

# ──────────────────────────────────────────────────────────────
# Contracts — auto-generated but COMMITTED intentionally
# (do NOT ignore contracts/)
# ──────────────────────────────────────────────────────────────
