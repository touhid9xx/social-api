# ============================================================================
# .env.prod — production environment
#
# DO NOT COMMIT THIS FILE. Add `.env.prod` to .gitignore.
#
# Setup:
#   1. Copy this template to .env.prod:
#        Copy-Item .env.prod.example .env.prod
#   2. Generate real secrets (see commands below), fill them in.
#   3. Place JWT PEM files in ./secrets/ (git-ignored, read-only mount).
#   4. `docker compose -f docker-compose.prod.yml up -d`
# ============================================================================

# ---- App ----------------------------------------------------------------
APP_NAME=Social API
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://api.your-domain.example.com    # HTTPS — used in emails
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn

# ---- Secrets backend ----------------------------------------------------
# `env` (default) works for single-host self-hosted deployments where
# .env.prod is the source of truth and the file has 0600 perms owned by
# the deploying user.
#
# For multi-host / cloud deploys, switch to aws-secrets-manager — it keeps
# secrets out of the filesystem entirely. Set AWS_SECRET_ID to the ARN of
# a JSON secret with this file's keys as top-level properties.
SECRETS_BACKEND=env
# AWS_SECRET_ID=arn:aws:secretsmanager:us-east-1:123456789012:secret:social-api/prod
# AWS_REGION=us-east-1

# ---- Security -----------------------------------------------------------
# JWT_ISSUER and JWT_AUDIENCE must DIFFER from dev so a dev-issued token
# can never be replayed against prod.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt_public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=social-api-prod
JWT_AUDIENCE=social-api-prod-clients

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=SomeKyeToasdasdasdasdasd

# ---- DB (MySQL) ---------------------------------------------------------
# The api/worker/migrate containers reach mysql over the backend network
# at hostname `mysql`, port 3306 (container port, not host port).
MYSQL_ROOT_PASSWORD=testpasssss
MYSQL_USER=social
MYSQL_PASSWORD=testpaas
MYSQL_DB=social
DATABASE_URL=mysql+asyncmy://social:testpaas@mysql:3306/social?charset=utf8mb4

# ---- Redis --------------------------------------------------------------
# Redis is only on the internal `backend` network. No password required
# by Redis config today; if you enable REDIS_PASSWORD on the redis
# service, embed it here: redis://:PASSWORD@redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1

# ---- Celery -------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_POOL=prefork
CELERY_CONCURRENCY=4
FEED_FANOUT_THRESHOLD=5000

# ---- Media --------------------------------------------------------------
MEDIA_BACKEND=local
MEDIA_ROOT=/app/data/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
# Prod: never skip ClamAV. Requires the clamd service and `pyclamd` in
# the image; if you haven't deployed clamd yet, keep `true` and add a
# TODO — a compromised file upload is worse than slower uploads.
SKIP_VIRUS_SCAN=false
S3_BUCKET=
S3_REGION=us-east-1

# ---- Email --------------------------------------------------------------
# Real SMTP in prod. Examples:
#   AWS SES:      email-smtp.us-east-1.amazonaws.com, port 587, TLS on
#   Mailtrap:     live.smtp.mailtrap.io, port 587, TLS on
#   SendGrid:     smtp.sendgrid.net, port 587, TLS on
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=test@test.com
SMTP_USER=testuser
SMTP_PASSWORD=testpass
SMTP_TLS=true

# ---- Observability ------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_SERVICE_NAME=social-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ---- Rate limits --------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---- Feature flags ------------------------------------------------------
FF_WS_ENABLED=true
FF_CHAT_ENABLED=true
FF_GDPR_ENABLED=true
# Set to true ONLY once you have celebrity users (> FEED_FANOUT_THRESHOLD
# followers) — fan-out burns CPU per normal-user post. If unsure, leave
# false and enable after checking worker CPU.
FF_FEED_FANOUT_ENABLED=false

# ---- CORS ---------------------------------------------------------------
# Must be HTTPS in prod. No wildcard, no localhost.
CORS_ORIGINS=https://your-frontend.example.com

# ---- GDPR / retention ---------------------------------------------------
GDPR_DELETION_WINDOW_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_MESSAGES_DAYS=365
RETENTION_ORPHAN_MEDIA_DAYS=30
RETENTION_SOFT_DELETED_DAYS=30

# ---- Compose-level (not read by the app) --------------------------------
# Gunicorn worker count — docker-compose.prod.yml reads this from the
# `api` service's environment block, not from .env.prod. Kept here for
# visibility so operators can see the intended count.
GUNICORN_WORKERS=4

GRAFANA_ADMIN_PASSWORD=testpass
