# ---- App ----
APP_NAME=Social API
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn

# ---- Security ----
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=social-api
JWT_AUDIENCE=social-api-clients

ENCRYPTION_KEY=                    # base64 32-byte Fernet key (generate below)

# ---- DB (MySQL) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=social
MYSQL_PASSWORD=socialpass
MYSQL_DB=social
DATABASE_URL=mysql+asyncmy://social:socialpass@127.0.0.1:3306/social?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CELERY_URL=redis://127.0.0.1:6379/1

# ---- Celery ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Media ----
MEDIA_ROOT=./data/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
SKIP_VIRUS_SCAN=true

# ---- Email ----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@social.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# ---- Observability ----
LOG_LEVEL=DEBUG
LOG_FORMAT=console                 # console | json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=social-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# ---- Rate limits ----
RATE_LIMIT_ENABLED=true

# ---- Feature flags ----
FF_WS_ENABLED=true
FF_CHAT_ENABLED=true
FF_GDPR_ENABLED=true
FF_FEED_FANOUT_ENABLED=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Media ----
MEDIA_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
